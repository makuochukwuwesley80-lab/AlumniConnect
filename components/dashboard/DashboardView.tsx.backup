"use client";

import * as React from "react";
import Link from "next/link";
import { useTheme } from "next-themes";
import { motion } from "framer-motion";
import {
  ArrowUpRight,
  Briefcase,
  Calendar,
  GraduationCap,
  Megaphone,
  MessageCircle,
  Monitor,
  Moon,
  Sparkles,
  Sun,
  MapPin,
} from "lucide-react";
import { cn } from "@/lib/utils";
import type { DashboardAnnouncement } from "@/app/(dashboard)/dashboard/page";

type DashboardViewProps = {
  featured: DashboardAnnouncement | null;
  counts: {
    announcements: number;
    events: number;
    opportunities: number;
    members: number;
  };
};

function formatHeroDate(dateString?: string | null) {
  if (!dateString) return null;
  const date = new Date(dateString);
  if (Number.isNaN(date.getTime())) return null;
  return new Intl.DateTimeFormat("en-US", {
    weekday: "short",
    month: "short",
    day: "numeric",
    hour: "numeric",
    minute: "2-digit",
  }).format(date);
}

function greeting() {
  const hour = new Date().getHours();
  if (hour < 12) return "Good morning";
  if (hour < 18) return "Good afternoon";
  return "Good evening";
}

function todayLabel() {
  return new Intl.DateTimeFormat("en-US", {
    weekday: "long",
    month: "long",
    day: "numeric",
  }).format(new Date());
}

function ThemeSwitcher() {
  const { theme, setTheme } = useTheme();
  const [mounted, setMounted] = React.useState(false);

  React.useEffect(() => {
    setMounted(true);
  }, []);

  const options = [
    { value: "light", icon: Sun, label: "Light" },
    { value: "system", icon: Monitor, label: "System" },
    { value: "dark", icon: Moon, label: "Dark" },
  ] as const;

  return (
    <div
      className={cn(
        "inline-flex items-center gap-0.5 rounded-full p-1",
        "border border-white/30 dark:border-white/10",
        "bg-white/50 dark:bg-black/40",
        "shadow-[0_8px_32px_rgba(0,0,0,0.12)]",
        "backdrop-blur-2xl backdrop-saturate-150"
      )}
    >
      {options.map(({ value, icon: Icon, label }) => {
        const active = mounted && theme === value;
        return (
          <button
            key={value}
            type="button"
            aria-label={label}
            onClick={() => setTheme(value)}
            className={cn(
              "flex h-9 w-9 items-center justify-center rounded-full transition-all duration-300",
              active
                ? "bg-white text-sky-600 shadow-sm dark:bg-zinc-800 dark:text-sky-400"
                : "text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white"
            )}
          >
            <Icon className="h-4 w-4" />
          </button>
        );
      })}
    </div>
  );
}

function DashCard({
  href,
  icon: Icon,
  label,
  value,
  delay,
}: {
  href: string;
  icon: React.ComponentType<{ className?: string }>;
  label: string;
  value: number;
  delay: number;
}) {
  return (
    <motion.div
      initial={{ opacity: 0, y: 18 }}
      animate={{ opacity: 1, y: 0 }}
      transition={{ type: "spring", stiffness: 260, damping: 24, delay }}
      className="h-full"
    >
      <Link
        href={href}
        className={cn(
          "group relative flex h-full min-h-[168px] flex-col justify-between overflow-hidden rounded-[28px] p-6",
          "border border-white/35 dark:border-white/10",
          "bg-white/55 dark:bg-white/[0.07]",
          "shadow-[0_12px_40px_rgba(0,0,0,0.08)] dark:shadow-[0_12px_40px_rgba(0,0,0,0.35)]",
          "backdrop-blur-3xl backdrop-saturate-150",
          "transition-all duration-500 ease-out",
          "hover:-translate-y-1.5 hover:bg-white/75 dark:hover:bg-white/[0.12]",
          "hover:shadow-[0_20px_50px_rgba(0,0,0,0.12)]",
          "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400/70"
        )}
      >
        <div className="pointer-events-none absolute inset-0 bg-gradient-to-br from-white/50 via-transparent to-sky-400/10 dark:from-white/10 dark:to-sky-500/10" />
        <div className="pointer-events-none absolute inset-x-0 top-0 h-px bg-white/60 dark:bg-white/20" />

        <div className="relative z-10 flex items-start justify-between">
          <div className="flex h-11 w-11 items-center justify-center rounded-2xl bg-sky-500/15 text-sky-600 dark:bg-sky-400/15 dark:text-sky-400">
            <Icon className="h-5 w-5" />
          </div>
          <ArrowUpRight className="h-4 w-4 text-zinc-400 opacity-0 transition-all duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:opacity-100 dark:text-zinc-300" />
        </div>

        <div className="relative z-10">
          <p className="text-[13px] font-medium tracking-wide text-zinc-600 dark:text-zinc-300">
            {label}
          </p>
          <p className="mt-1 text-4xl font-semibold tracking-tight text-zinc-900 dark:text-white">
            {value}
          </p>
          <p className="mt-1 text-[11px] font-medium uppercase tracking-[0.14em] text-zinc-500 dark:text-zinc-400">
            Live from Supabase
          </p>
        </div>
      </Link>
    </motion.div>
  );
}

export default function DashboardView({
  featured,
  counts,
}: DashboardViewProps) {
  const hasImage = Boolean(featured?.image_url);
  const eventDate = formatHeroDate(featured?.event_date);

  return (
    <div className="relative min-h-[calc(100vh-5.5rem)] overflow-hidden rounded-[32px]">
      <div className="pointer-events-none absolute inset-0 overflow-hidden">
        {hasImage ? (
          <div
            className="absolute inset-0 scale-105 bg-cover bg-center"
            style={{ backgroundImage: `url(${featured!.image_url})` }}
          />
        ) : (
          <>
            <div className="absolute -top-24 left-1/2 h-[520px] w-[820px] -translate-x-1/2 rounded-full bg-sky-400/25 blur-[120px] dark:bg-sky-600/20" />
            <div className="absolute bottom-0 right-0 h-[380px] w-[520px] rounded-full bg-indigo-400/20 blur-[110px] dark:bg-indigo-600/15" />
          </>
        )}
        <div
          className={cn(
            "absolute inset-0",
            hasImage
              ? "bg-gradient-to-b from-white/75 via-white/55 to-white/80 dark:from-black/55 dark:via-black/65 dark:to-black/80"
              : "bg-gradient-to-b from-white/40 via-transparent to-white/50 dark:from-black/20 dark:to-black/50"
          )}
        />
      </div>

      <div className="relative z-10 flex min-h-[calc(100vh-5.5rem)] flex-col px-4 py-6 sm:px-6 lg:px-8">
        <div className="mb-8 flex flex-wrap items-start justify-between gap-4">
          <div>
            <p className="text-sm font-medium text-zinc-600 dark:text-zinc-300">
              {todayLabel()}
            </p>
            <h1 className="mt-1 text-3xl font-semibold tracking-tight text-zinc-900 dark:text-white sm:text-4xl">
              {greeting()}
            </h1>
            <p className="mt-1 text-sm text-zinc-500 dark:text-zinc-400">
              AlumniConnect
            </p>
          </div>
          <ThemeSwitcher />
        </div>

        {featured && (
          <motion.div
            initial={{ opacity: 0, y: 16 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ type: "spring", stiffness: 240, damping: 22 }}
            className="mb-8"
          >
            <Link
              href={`/announcements/${featured.id}`}
              className={cn(
                "group relative block overflow-hidden rounded-[32px] p-6 sm:p-8",
                "border border-white/35 dark:border-white/10",
                "bg-white/40 dark:bg-black/30",
                "backdrop-blur-3xl backdrop-saturate-150",
                "shadow-[0_16px_50px_rgba(0,0,0,0.1)]",
                "transition-all duration-500 hover:bg-white/55 dark:hover:bg-black/40",
                "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400/70"
              )}
            >
              <div className="pointer-events-none absolute inset-x-0 top-0 h-px bg-white/50" />

              <div className="mb-4 flex flex-wrap items-center gap-2">
                {featured.featured && (
                  <span className="inline-flex items-center gap-1.5 rounded-full bg-sky-500 px-3 py-1 text-[11px] font-semibold uppercase tracking-wider text-white">
                    <Sparkles className="h-3 w-3" />
                    Featured
                  </span>
                )}
                {eventDate && (
                  <span className="inline-flex items-center gap-1.5 rounded-full bg-white/40 px-3 py-1 text-xs font-medium text-zinc-800 backdrop-blur-md dark:bg-white/10 dark:text-zinc-100">
                    <Calendar className="h-3.5 w-3.5" />
                    {eventDate}
                  </span>
                )}
                {featured.venue && (
                  <span className="inline-flex items-center gap-1.5 rounded-full bg-white/40 px-3 py-1 text-xs font-medium text-zinc-800 backdrop-blur-md dark:bg-white/10 dark:text-zinc-100">
                    <MapPin className="h-3.5 w-3.5" />
                    {featured.venue}
                  </span>
                )}
              </div>

              <h2 className="max-w-3xl text-2xl font-semibold tracking-tight text-zinc-900 dark:text-white sm:text-3xl md:text-4xl">
                {featured.title}
              </h2>

              {featured.body && (
                <p className="mt-3 max-w-2xl text-[15px] leading-relaxed text-zinc-600 line-clamp-2 dark:text-zinc-300">
                  {featured.body}
                </p>
              )}

              <span className="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-sky-600 dark:text-sky-400">
                Open announcement
                <ArrowUpRight className="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
              </span>
            </Link>
          </motion.div>
        )}

        <div className="grid flex-1 grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
          <DashCard
            href="/announcements"
            icon={Megaphone}
            label="Announcements"
            value={counts.announcements}
            delay={0.05}
          />
          <DashCard
            href="/events"
            icon={Calendar}
            label="Events"
            value={counts.events}
            delay={0.1}
          />
          <DashCard
            href="/opportunities"
            icon={Briefcase}
            label="Opportunities"
            value={counts.opportunities}
            delay={0.15}
          />
          <DashCard
            href="/messages"
            icon={MessageCircle}
            label="Messages"
            value={counts.members}
            delay={0.2}
          />
        </div>

        <div className="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
          <DashCard
            href="/directory"
            icon={GraduationCap}
            label="Alumni"
            value={counts.members}
            delay={0.25}
          />
          <motion.div
            initial={{ opacity: 0, y: 18 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ type: "spring", stiffness: 260, damping: 24, delay: 0.3 }}
          >
            <Link
              href="/announcements"
              className={cn(
                "group relative flex h-full min-h-[168px] items-end overflow-hidden rounded-[28px] p-6",
                "border border-sky-400/30",
                "bg-sky-500/20 dark:bg-sky-500/15",
                "backdrop-blur-3xl",
                "transition-all duration-500 hover:-translate-y-1.5 hover:bg-sky-500/30"
              )}
            >
              <div className="relative z-10">
                <p className="text-sm font-medium text-sky-800 dark:text-sky-200">
                  Stay in the loop
                </p>
                <p className="mt-1 text-2xl font-semibold tracking-tight text-zinc-900 dark:text-white">
                  Browse all announcements
                </p>
              </div>
              <ArrowUpRight className="absolute right-6 top-6 h-5 w-5 text-sky-700 dark:text-sky-300" />
            </Link>
          </motion.div>
        </div>
      </div>
    </div>
  );
}
