import type { Metadata, Viewport } from "next";
import { Inter } from "next/font/google";
import "./globals.css";
import { ThemeProvider } from "@/components/providers/theme-provider";
import { AuthProvider } from "@/components/providers/auth-provider";
import { Toaster } from "@/components/ui/toaster";
import { cn } from "@/lib/utils";

const inter = Inter({
  subsets: ["latin"],
  variable: "--font-inter",
  display: "swap",
});

export const metadata: Metadata = {
  title: {
    default: "AlumniConnect",
    template: "%s · AlumniConnect",
  },
  description:
    "Premium alumni networking platform with messaging, announcements, and class communities. Designed with Apple-inspired glassmorphism.",
  applicationName: "AlumniConnect",
  keywords: [
    "alumni",
    "networking",
    "messaging",
    "class chat",
    "announcements",
    "AlumniConnect",
  ],
  authors: [{ name: "AlumniConnect" }],
  creator: "AlumniConnect",
  publisher: "AlumniConnect",
  formatDetection: {
    email: false,
    address: false,
    telephone: false,
  },
  metadataBase: new URL(
    process.env.NEXT_PUBLIC_APP_URL ?? "http://localhost:3000"
  ),
  openGraph: {
    type: "website",
    locale: "en_US",
    url: "/",
    title: "AlumniConnect",
    description:
      "Connect with your class, share announcements, and stay in touch with a premium glassmorphism experience.",
    siteName: "AlumniConnect",
  },
  twitter: {
    card: "summary_large_image",
    title: "AlumniConnect",
    description:
      "Premium alumni networking with messaging, class chats, and announcements.",
  },
  robots: {
    index: true,
    follow: true,
  },
};

export const viewport: Viewport = {
  themeColor: [
    { media: "(prefers-color-scheme: light)", color: "#f5f5f7" },
    { media: "(prefers-color-scheme: dark)", color: "#000000" },
  ],
  width: "device-width",
  initialScale: 1,
  viewportFit: "cover",
};

export default function RootLayout({
  children,
}: Readonly<{
  children: React.ReactNode;
}>) {
  return (
    <html lang="en" suppressHydrationWarning className={cn(inter.variable)}>
      <head>
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
        <meta name="apple-mobile-web-app-capable" content="yes" />
        <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
      </head>
      <body
        className={cn(
          "min-h-screen bg-slate-50 font-sans antialiased dark:bg-black",
          "selection:bg-blue-500/30 selection:text-foreground",
          "overflow-x-hidden"
        )}
      >
        <ThemeProvider
          attribute="class"
          defaultTheme="system"
          enableSystem
          disableTransitionOnChange={false}
        >
          <AuthProvider>
            <div className="relative flex min-h-screen flex-col">
              <div className="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
                <div className="absolute -top-40 left-1/2 h-[620px] w-[920px] -translate-x-1/2 rounded-full bg-blue-500/25 blur-[130px] animate-pulse dark:bg-blue-600/20" />
                <div className="absolute top-1/3 -left-20 h-[380px] w-[520px] rounded-full bg-indigo-400/15 blur-[110px] animate-pulse [animation-duration:8s] dark:bg-indigo-500/12" />
                <div className="absolute bottom-0 right-0 h-[420px] w-[640px] rounded-full bg-sky-400/12 blur-[120px] animate-pulse [animation-duration:11s] dark:bg-sky-500/10" />
                <div className="absolute top-1/2 left-1/2 h-[280px] w-[280px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-blue-300/10 blur-[90px] animate-pulse [animation-duration:6s] dark:bg-blue-400/8" />
              </div>
              <main className="flex-1">{children}</main>
            </div>
            <Toaster />
          </AuthProvider>
        </ThemeProvider>
      </body>
    </html>
  );
}
